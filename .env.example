# Used by the API worker (api/index.ts). For local `npm run dev`, copy to .env (or .dev.vars).
# In production set these in Cloudflare: Worker "panha" → Settings → Variables and Secrets.
# (The older NUXT_* names are still accepted.)

# Secrets
GEMINI_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SUPABASE_SERVICE_ROLE_KEY=

# Plain variables
SUPABASE_URL=https://your-project.supabase.co
