{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "panha",
  // Small API worker: handles /api/chat and /api/contact only.
  "main": "./api/index.ts",
  "compatibility_date": "2025-09-01",
  "assets": {
    // Flutter Web build output (`npm run build`).
    "directory": "./build/web",
    "binding": "ASSETS",
    // Only /api/* reaches the worker; every other request is served straight from the Flutter build.
    "run_worker_first": ["/api/*"],
    "not_found_handling": "single-page-application"
  },
  "observability": {
    "enabled": true
  }
  // Secrets (GEMINI_API_KEY, TELEGRAM_BOT_TOKEN, TELEGRAM_CHAT_ID, SUPABASE_SERVICE_ROLE_KEY) and
  // SUPABASE_URL are set in the Cloudflare dashboard (Worker → Settings → Variables and Secrets).
  // The older NUXT_* names are also accepted. Never put secret values in this file.
}
