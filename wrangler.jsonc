{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "panha",
  // Built by `nuxt build` with the `cloudflare_module` Nitro preset (see nuxt.config.ts).
  "main": "./.output/server/index.mjs",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./.output/public",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  }
  // Secrets (NUXT_GEMINI_API_KEY, NUXT_TELEGRAM_BOT_TOKEN, NUXT_TELEGRAM_CHAT_ID,
  // NUXT_SUPABASE_SERVICE_ROLE_KEY) and NUXT_PUBLIC_SUPABASE_URL / NUXT_PUBLIC_SUPABASE_ANON_KEY
  // are set in the Cloudflare dashboard (Worker → Settings → Variables and Secrets), never here.
}
